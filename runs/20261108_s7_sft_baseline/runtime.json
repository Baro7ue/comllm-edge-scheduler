{
  "environment": {
    "versions": {
      "torch": "2.14.1+cu130",
      "transformers": "5.20.2",
      "peft": "0.21.2",
      "accelerate": "1.15.0",
      "numpy": "2.4.6"
    },
    "gpu": "NVIDIA RTX PRO 6000 Blackwell Server Edition"
  },
  "tokenizer": {
    "eos_ids": [
      151645
    ],
    "pad_token_id": 151643,
    "padding_side": "left",
    "num_beams": 1,
    "num_beams_raw": null,
    "num_beams_effective": 1,
    "cuda_version": "13.0"
  },
  "adapter_audit": {
    "adapter_loaded": false,
    "lora_parameter_count": 0,
    "optimizer_created": false,
    "new_lora_B_zero_check": "not_applicable_no_adapter_constructed",
    "model_class": "transformers.models.qwen2.modeling_qwen2.Qwen2ForCausalLM"
  },
  "decode": {
    "format": "repo",
    "parse": [
      "search",
      "strict"
    ],
    "do_sample": false,
    "max_new_tokens": 15,
    "repetition_penalty": 1.0,
    "eval_batch": 4,
    "max_seq_length": 2048,
    "use_cache": true,
    "seed": 0,
    "eos_rule": "list({tokenizer.eos_token_id, tokenizer.convert_tokens_to_ids('<|im_end|>')}) filtered >=0"
  }
}
